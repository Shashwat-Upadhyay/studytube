# Application Settings
PROJECT_NAME="StudyTube API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# CORS Configuration
# Include your unpacked Chrome extension origin here when loaded:
# Format: chrome-extension://<EXTENSION_ID>
# Multiple origins can be comma-separated or JSON list
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,chrome-extension://placeholder-extension-id"

# Enable matching all local unpacked chrome-extension:// origins during development
CORS_ALLOW_EXTENSION_REGEX=true

# Future LLM Integration (Placeholders only - DO NOT commit real secrets)
LLM_PROVIDER="placeholder"
LLM_API_KEY="your-llm-api-key-here"
LLM_MODEL="placeholder-model"
