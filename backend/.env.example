# Application Settings
PROJECT_NAME="StudyTube API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# CORS Configuration
# Include your unpacked Chrome extension origin here when loaded:
# Format: chrome-extension://<EXTENSION_ID>
# Multiple origins can be comma-separated or JSON list
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,chrome-extension://placeholder-extension-id"

# Enable matching all local unpacked chrome-extension:// origins during development
CORS_ALLOW_EXTENSION_REGEX=true

# LLM Classifier Configuration
# Options for LLM_PROVIDER: "placeholder", "ollama", "gemini", "openai"
#
# Option A: Placeholder (Default - mock/offline mode, no setup needed)
# LLM_PROVIDER="placeholder"
# LLM_API_KEY=""
# LLM_MODEL="placeholder"

# Option B: Ollama (Local LLM, 100% Free & Offline, No API key needed)
# Run in terminal: ollama run llama3.2:3b (or mistral, phi3, qwen2.5)
# LLM_PROVIDER="ollama"
# LLM_MODEL="llama3.2:3b"
# LLM_BASE_URL="http://localhost:11434/v1"

# Option C: Google Gemini (Cloud)
# LLM_PROVIDER="gemini"
# LLM_API_KEY="AIzaSy..."
# LLM_MODEL="gemini-1.5-flash"   # Options: "gemini-1.5-flash", "gemini-1.5-pro", "gemini-2.0-flash"

# Option D: OpenAI or OpenAI-Compatible Cloud (Groq, OpenRouter, vLLM)
# LLM_PROVIDER="openai"
# LLM_API_KEY="sk-..."
# LLM_MODEL="gpt-4o-mini"
# LLM_BASE_URL="https://api.openai.com/v1"

# LLM Network & Cache Settings
LLM_TIMEOUT_SECONDS=8.0
CACHE_SIZE=1000
LLM_FALLBACK_DEFAULT="gaming"
